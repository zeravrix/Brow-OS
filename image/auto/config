#!/bin/sh
# live-build configuration for Brave OS. This is the single place that sets
# every `lb config` option. Edit the locale, keyboard and timezone below to
# match your laptop before building.
#
# Boot parameters used (live-config): username, hostname, locales,
# keyboard-layouts, timezone.

set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--apt-recommends false \
	--security true \
	--updates true \
	--binary-images iso-hybrid \
	--debian-installer none \
	--image-name brave-os \
	--iso-application "Brave OS" \
	--iso-publisher "Brave OS project" \
	--iso-volume "BRAVE-OS" \
	--memtest none \
	--bootappend-live "boot=live components quiet loglevel=3 username=brave hostname=brave-os locales=en_US.UTF-8 keyboard-layouts=us timezone=UTC" \
	"${@}"
