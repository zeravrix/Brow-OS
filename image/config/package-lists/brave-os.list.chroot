# Brave OS package list. Names are for Debian 13 (trixie). If the build stops
# with "Unable to locate package X", delete or rename X and build again.

# --- system basics ---
systemd-sysv
dbus
dbus-user-session
polkitd
# USB drives and Bluetooth are installed but switched off (masked) until you
# turn them on with the menu or brave-os-switch, so they use no memory.
udisks2
bluez
libspa-0.2-bluetooth
nftables
systemd-zram-generator
# Used by the save-file scripts (copying, finding processes).
rsync
procps
# Kills the biggest program before the machine freezes when memory runs out.
earlyoom
unattended-upgrades
ca-certificates
curl
gnupg
locales
tzdata
console-setup
keyboard-configuration
# Normal Debian terminal: the first user keeps sudo, like a regular Debian install.
sudo

# --- installer (graphical, started with "sudo install os") ---
# Calamares copies the live system to a disk and installs the bootloader.
# calamares-settings-debian supplies Debian's installer configuration.
# The grub/efi packages must be in the live image for the bootloader step.
calamares
calamares-settings-debian
qt6-wayland
grub-efi-amd64
grub-pc-bin
efibootmgr
os-prober
rsync
parted
dosfstools
e2fsprogs
cryptsetup

# --- network ---
network-manager
wpasupplicant
wireless-regdb
iw
rfkill

# --- graphics and compositor ---
labwc
libgl1-mesa-dri
libegl1
libgles2
mesa-va-drivers
vainfo

# --- audio, brightness ---
pipewire
pipewire-pulse
wireplumber
alsa-utils
brightnessctl

# --- tiny helpers used by the menu ---
fuzzel
foot

# --- fonts (do not trim: missing fonts break web pages) ---
fonts-liberation
fonts-noto-core
fonts-noto-color-emoji

# --- hardware probe tools ---
pciutils
usbutils
dmidecode
