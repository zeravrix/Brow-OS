#!/bin/sh
# One-time cleanup on an installed system: removes the installer and the
# live-session packages, which are not needed once Brave OS is on a disk.
# Does nothing in the live USB session.
set -u
[ -d /run/live/medium ] && exit 0
marker=/var/lib/brave-os/cleaned
[ -e "$marker" ] && exit 0
mkdir -p /var/lib/brave-os

list=""
for p in calamares calamares-settings-debian qt6-wayland live-boot live-boot-initramfs-tools live-config live-config-systemd; do
	if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed"; then
		list="$list $p"
	fi
done

if [ -n "$list" ]; then
	export DEBIAN_FRONTEND=noninteractive
	# shellcheck disable=SC2086
	apt-get purge -y $list && apt-get autoremove --purge -y && apt-get clean
fi
touch "$marker"
exit 0
