#!/bin/sh
# Milestone 1 hardware probe. Run in the live session as root:
#     sudo brave-os-probe [output-directory]
# Writes one text report. Copy it to a USB stick and send it back.
out_dir="${1:-$HOME}"
out="$out_dir/brave-os-probe-$(date +%Y%m%d-%H%M%S).txt"

section() { printf '\n===== %s =====\n' "$1"; }
run() { section "$*"; "$@" 2>&1; }

{
	section "date and kernel"
	date
	uname -a
	cat /proc/cmdline
	[ -f /etc/brave-os-brave-version ] && cat /etc/brave-os-brave-version

	run dmidecode -t system -t baseboard -t bios
	run lscpu
	section "cpu flags of interest (expect sse4_2, aes; avx absent on N3060)"
	grep -m1 '^flags' /proc/cpuinfo | tr ' ' '\n' | grep -E '^(sse3|ssse3|sse4_1|sse4_2|avx|avx2|aes)$' | sort -u
	run free -m
	run lsblk -d -o NAME,ROTA,SIZE,MODEL,TRAN
	section "firmware mode (64 or 32 means UEFI of that width; missing means legacy BIOS)"
	cat /sys/firmware/efi/fw_platform_size 2>&1
	run lspci -nnk
	run lsusb
	section "graphics"
	ls /sys/class/drm 2>&1
	for d in i965 iHD; do
		section "vainfo with driver $d"
		LIBVA_DRIVER_NAME="$d" vainfo 2>&1
	done
	section "vainfo default"
	vainfo 2>&1
	section "kernel firmware errors"
	dmesg 2>&1 | grep -iE 'firmware|failed to load' | head -n 50
	section "network"
	nmcli device status 2>&1
	rfkill list 2>&1
	section "sound"
	aplay -l 2>&1
	section "power"
	for p in /sys/class/power_supply/*; do
		[ -d "$p" ] && { echo "$p"; cat "$p/type" "$p/status" 2>/dev/null; }
	done
	section "boot timing"
	systemd-analyze 2>&1
	systemd-analyze blame 2>&1 | head -n 15
} > "$out" 2>&1

echo "Report written to: $out"
echo "Copy it to a USB stick before shutting down; the live session forgets it."
