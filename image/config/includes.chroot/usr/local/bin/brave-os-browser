#!/bin/sh
# Starts Brave for the Brave OS session. Extra flags for experiments go in
# /etc/brave-os/browser.conf (EXTRA_FLAGS). Never add --no-sandbox.
#
# Low-memory behaviour is chosen automatically:
#  - 3 GB of RAM or less: Chromium's low-end-device mode (fewer caches, lighter tabs).
#  - Live USB session: the browser cache is capped, because in the live session
#    every file written lives in RAM. Downloads also use RAM there.
# Set LOW_MEMORY=0 or LOW_MEMORY=1 in browser.conf to override the RAM check.
EXTRA_FLAGS=""
LOW_MEMORY=auto
if [ -r /etc/brave-os/browser.conf ]; then
	# shellcheck disable=SC1091
	. /etc/brave-os/browser.conf
fi

if [ "$LOW_MEMORY" = "auto" ]; then
	mem_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo)
	if [ "${mem_kb:-0}" -le 3000000 ]; then LOW_MEMORY=1; else LOW_MEMORY=0; fi
fi

auto_flags=""
if [ "$LOW_MEMORY" = "1" ]; then
	auto_flags="$auto_flags --enable-low-end-device-mode"
fi
if [ -d /run/live/medium ]; then
	auto_flags="$auto_flags --disk-cache-size=67108864"
fi

# shellcheck disable=SC2086
exec brave-browser --ozone-platform=wayland --start-maximized \
	--no-first-run --no-default-browser-check $auto_flags $EXTRA_FLAGS "$@"
