#!/bin/sh
# Console autologin for the first normal account (the live user "brave" on the
# USB stick, or the account chosen during installation).
# Usage (from the getty@tty1 drop-in): brave-os-getty tty1 $TERM
tty=${1:-tty1}
term=${2:-linux}
user=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }')
if [ -n "$user" ]; then
	exec /sbin/agetty --autologin "$user" --noclear "$tty" "$term"
fi
exec /sbin/agetty --noclear "$tty" "$term"
