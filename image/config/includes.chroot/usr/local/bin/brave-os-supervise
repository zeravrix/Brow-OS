#!/bin/sh
# Keeps Brave running: restarts it after a crash, but not after a normal close.
# Gives up after 3 failures within 2 minutes so a broken browser cannot spin.
lock="${XDG_RUNTIME_DIR:-/tmp}/brave-os-supervise.lock"
exec 9>"$lock"
flock -n 9 || exit 0

fails=0
window_start=$(date +%s)
while :; do
	# 9>&- keeps Brave from inheriting the lock, so a relaunch can take it.
	/usr/local/bin/brave-os-browser 9>&-
	rc=$?
	[ "$rc" -eq 0 ] && exit 0
	now=$(date +%s)
	if [ $((now - window_start)) -gt 120 ]; then
		fails=0
		window_start=$now
	fi
	fails=$((fails + 1))
	[ "$fails" -ge 3 ] && exit 1
	sleep 2
done
