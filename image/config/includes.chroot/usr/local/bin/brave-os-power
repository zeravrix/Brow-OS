#!/bin/sh
# Shut down or restart. In the live USB session it first asks whether to save
# (or update) your session. On an installed system everything is already saved.
#   brave-os-power shutdown | reboot
case "${1:-}" in
	shutdown) cmd=poweroff; word="shut down" ;;
	reboot) cmd=reboot; word="restart" ;;
	*) echo "Usage: brave-os-power shutdown|reboot"; exit 1 ;;
esac

if [ -d /run/live/medium ]; then
	answer=$(printf '%s\n' "Yes: save my session, then $word" "No: $word without saving" "Cancel" \
		| fuzzel --dmenu --prompt "Save your session? ")
	case "$answer" in
		Yes*)
			rm -f /run/brave-os-save.ok
			foot -e /usr/local/bin/brave-os-save save --no-relaunch
			if [ ! -e /run/brave-os-save.ok ]; then
				again=$(printf '%s\n' "Do not $word: go back" "$word anyway, without saving" \
					| fuzzel --dmenu --prompt "The save did not finish. ")
				case "$again" in
					*anyway*) ;;
					*) exit 0 ;;
				esac
			fi
			;;
		No*) ;;
		*) exit 0 ;;
	esac
fi
exec systemctl "$cmd"
