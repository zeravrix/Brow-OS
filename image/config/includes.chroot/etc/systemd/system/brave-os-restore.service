[Unit]
Description=Brave OS: load the saved session (live USB only)
ConditionPathExists=/run/live/medium
After=live-config.service NetworkManager.service local-fs.target
Before=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=/usr/local/bin/brave-os-save restore

[Install]
WantedBy=multi-user.target
