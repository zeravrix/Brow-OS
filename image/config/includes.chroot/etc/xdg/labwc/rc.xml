<?xml version="1.0"?>
<!--
  Brave OS labwc configuration (system-wide, read from /etc/xdg/labwc).
  Press Super+Space or Ctrl+Shift+Delete to show or hide the top bar.
-->
<labwc_config>
  <keyboard>
    <default />
    <!-- Windows key alone opens a terminal (fires on release so Super+Space still works). -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/usr/local/bin/brave-os-toggle-bar" />
    </keybind>
    <keybind key="C-S-Delete">
      <action name="Execute" command="/usr/local/bin/brave-os-toggle-bar" />
    </keybind>
    <keybind key="XF86_PowerOff">
      <action name="Execute" command="/usr/local/bin/brave-os-power shutdown" />
    </keybind>
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86_MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+" />
    </keybind>
    <keybind key="XF86_MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>
</labwc_config>
