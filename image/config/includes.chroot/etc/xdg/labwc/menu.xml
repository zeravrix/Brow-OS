<?xml version="1.0" encoding="UTF-8"?>
<!-- Brave OS root menu. The Wi-Fi list is generated on demand by a script. -->
<openbox_menu>
  <menu id="root-menu" label="Brave OS">
    <menu id="wifi-menu" label="Wi-Fi networks" execute="/usr/local/bin/brave-os-wifi-pipemenu" />
    <item label="Open or restart Brave">
      <action name="Execute" command="/usr/local/bin/brave-os-relaunch" />
    </item>
    <separator />
    <item label="Terminal">
      <action name="Execute" command="foot" />
    </item>
    <menu id="extras-menu" label="Bluetooth and USB drives">
      <item label="Bluetooth: turn on and pair">
        <action name="Execute" command="foot -e brave-os-switch bluetooth pair" />
      </item>
      <item label="Bluetooth: turn off">
        <action name="Execute" command="foot -e brave-os-switch bluetooth off" />
      </item>
      <item label="USB drives: turn on">
        <action name="Execute" command="foot -e brave-os-switch usb on" />
      </item>
      <item label="USB drives: turn off">
        <action name="Execute" command="foot -e brave-os-switch usb off" />
      </item>
    </menu>
    <item label="Install Brave OS to disk">
      <action name="Execute" command="foot -e install-os" />
    </item>
    <separator />
    <item label="Save session now (live USB)">
      <action name="Execute" command="foot -e brave-os-save save" />
    </item>
    <item label="Restart computer">
      <action name="Execute" command="/usr/local/bin/brave-os-power reboot" />
    </item>
    <item label="Shut down">
      <action name="Execute" command="/usr/local/bin/brave-os-power shutdown" />
    </item>
  </menu>
</openbox_menu>
