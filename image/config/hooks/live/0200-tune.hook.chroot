#!/bin/sh
# Final image tuning: permissions and which services are enabled.
set -e

chmod 0755 /usr/local/bin/brave-os-* || true
chmod 0755 /etc/xdg/labwc/autostart || true
chmod 0755 /usr/local/sbin/install || true

# Services we want on.
systemctl enable nftables.service || true
systemctl enable brave-os-hwdetect.timer || true
systemctl enable brave-os-firstboot.service || true
systemctl enable brave-os-restore.service || true
systemctl enable earlyoom.service || true

# Services a browser appliance does not need (no-ops if not installed).
# unattended-upgrades.service keeps a Python process in RAM; the daily apt timers
# run the upgrades without it.
# Bluetooth and USB-drive services are masked: they cannot start, even when another
# program asks for them over D-Bus, until brave-os-switch unmasks them.
systemctl mask bluetooth.service udisks2.service || true
for unit in unattended-upgrades.service ModemManager.service avahi-daemon.service cups.service ssh.service \
	man-db.timer e2scrub_all.timer e2scrub_reap.service dpkg-db-backup.timer; do
	systemctl disable "$unit" 2>/dev/null || true
done

# Turn on the daily package-list refresh and automatic upgrades.
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
