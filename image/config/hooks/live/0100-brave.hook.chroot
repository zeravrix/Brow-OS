#!/bin/sh
# Adds Brave's official apt repository and installs the release package.
# URLs, keyring path and sources-file path are the ones Brave documents at
# https://www.brave.com/linux for Debian and Ubuntu.
set -e

install -d -m 0755 /usr/share/keyrings /etc/apt/sources.list.d

curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
	https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources \
	https://brave-browser-apt-release.s3.brave.com/brave-browser.sources

# Record the signing key fingerprint in the build log so changes are visible.
gpg --show-keys --with-fingerprint /usr/share/keyrings/brave-browser-archive-keyring.gpg || true

apt-get update
apt-get install -y --no-install-recommends brave-browser

# Record the exact version that went into this image.
dpkg-query -W -f='brave-browser ${Version}\n' brave-browser > /etc/brave-os-brave-version
cat /etc/brave-os-brave-version

apt-get clean
