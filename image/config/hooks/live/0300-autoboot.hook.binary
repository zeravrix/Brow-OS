#!/bin/sh
# Brand both ISO boot paths while keeping a short hands-free boot countdown.
set -eu

branding="config/hooks/live/branding-splash.png"

if [ -f "$branding" ]; then
	install -D -m 0644 "$branding" binary/isolinux/splash.png
	install -D -m 0644 "$branding" binary/boot/grub/brow-os.png
fi

isolinux_cfg="binary/isolinux/isolinux.cfg"
if [ -f "$isolinux_cfg" ]; then
	# Show the branded menu briefly, then start the default Brow OS entry.
	sed -i -E \
		-e '/^[[:space:]]*MENU HIDDEN([[:space:]]|$)/Id' \
		-e 's/^([[:space:]]*PROMPT[[:space:]]+).*/\1 0/I' \
		-e 's/^([[:space:]]*TIMEOUT[[:space:]]+).*/\1 30/I' \
		-e 's/^([[:space:]]*MENU TITLE[[:space:]]+).*/\1Brow OS/I' \
		-e 's|^[[:space:]]*MENU BACKGROUND[[:space:]]+.*|MENU BACKGROUND splash.png|I' \
		"$isolinux_cfg"
	grep -qiE '^[[:space:]]*PROMPT[[:space:]]' "$isolinux_cfg" || printf '\nPROMPT 0\n' >> "$isolinux_cfg"
	grep -qiE '^[[:space:]]*TIMEOUT[[:space:]]' "$isolinux_cfg" || printf 'TIMEOUT 30\n' >> "$isolinux_cfg"
	grep -qiE '^[[:space:]]*MENU TITLE[[:space:]]' "$isolinux_cfg" || printf 'MENU TITLE Brow OS\n' >> "$isolinux_cfg"
	grep -qiE '^[[:space:]]*MENU BACKGROUND[[:space:]]' "$isolinux_cfg" || printf 'MENU BACKGROUND splash.png\n' >> "$isolinux_cfg"
	find binary/isolinux -type f \( -name '*.cfg' -o -name '*.cfg.in' \) \
		-exec sed -i -E \
			-e '/^[[:space:]]*MENU HIDDEN([[:space:]]|$)/Id' \
			-e 's/^([[:space:]]*MENU TITLE[[:space:]]+).*/\1Brow OS/I' \
			-e 's|^[[:space:]]*MENU BACKGROUND[[:space:]]+.*|MENU BACKGROUND splash.png|I' \
			-e 's/Debian GNU\/Linux Live/Brow OS/g' {} +
	rm -f binary/isolinux/splash.svg
fi

grub_cfg="binary/boot/grub/grub.cfg"
if [ -f "$grub_cfg" ]; then
	# Keep the UEFI menu visible, branded, and able to continue without input.
	sed -i -E \
		-e '/^[[:space:]]*set timeout_style=/d' \
		-e '/^[[:space:]]*set timeout=/d' \
		-e '/^[[:space:]]*(set theme=|background_image )/d' \
		-e 's/Debian GNU\/Linux Live/Brow OS/g' \
		-e 's/Debian GNU\/Linux/Brow OS/g' \
		"$grub_cfg"
	grub_tmp="${grub_cfg}.brave-os"
	{
		cat <<'EOF'
set gfxmode=auto
insmod all_video
insmod gfxterm
insmod png
terminal_output gfxterm
set menu_color_normal="white/black"
set menu_color_highlight="black/light-gray"
background_image /boot/grub/brow-os.png
set timeout_style=menu
set timeout=3
EOF
		cat "$grub_cfg"
	} > "$grub_tmp"
	mv "$grub_tmp" "$grub_cfg"
fi
